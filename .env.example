# ─── Aplicação ────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# 0 = sem proxy à frente; 1 = um proxy (cloud, reverse proxy).
TRUST_PROXY=0

# ─── Base de dados ────────────────────────────────────────────────────
# Formato: postgres://utilizador:password@host:porta/base_de_dados
DATABASE_URL=postgres://apupu_user:apupu_password@localhost:5432/apupu

# ─── CORS ─────────────────────────────────────────────────────────────
# Lista separada por vírgulas (sem espaços obrigatórios). Inclui a
# origem do frontend Angular.
CORS_ORIGIN=http://localhost:4200
# Em desenvolvimento aceita qualquer porta em localhost/127.0.0.1/[::1].
CORS_ALLOW_LOCALHOST=true

# ─── Rate limit ───────────────────────────────────────────────────────
# O limite global é aplicado em todos os ambientes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
# Endpoints públicos que recebem tokens de convite.
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_RATE_LIMIT_MAX=60
# Troca do segredo de gestão por sessão.
HOST_SESSION_RATE_LIMIT_WINDOW_MS=900000
HOST_SESSION_RATE_LIMIT_MAX=20
# Registo, login, reenvio de verificação e reposição de senha.
# Aplicado por IP e por IP + email.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
# Escritas autenticadas (eventos, convidados, reenvios) por conta/evento.
WRITE_RATE_LIMIT_WINDOW_MS=900000
WRITE_RATE_LIMIT_MAX=60
# RSVP público por IP + token de convite.
RSVP_RATE_LIMIT_WINDOW_MS=60000
RSVP_RATE_LIMIT_MAX=20

# ─── URLs públicas ────────────────────────────────────────────────────
# Base do frontend: usada para construir os links de gestão e de convite.
APP_BASE_URL=http://localhost:4200
# Base da API: usada pelo smoke test e pelos links de RSVP da API.
API_BASE_URL=http://localhost:3000

# ─── Tokens e sessões ─────────────────────────────────────────────────
# Pepper HMAC para tokens de gestão/convite e derivação CSRF.
# Nunca é guardado em base de dados; gerar com: openssl rand -base64 48
TOKEN_PEPPER=apupu_dev_only_token_pepper_mude_em_producao_2026

# Sessão de gestão (cookie HttpOnly, por evento).
HOST_COOKIE_NAME=apupu_host
HOST_SESSION_TTL_MINUTES=120
# Validade do link de gestão; roda a cada utilização.
MANAGE_TOKEN_TTL_DAYS=30

# Cookie CSRF legível por JS; o valor é derivado da capacidade HttpOnly.
CSRF_COOKIE_NAME=apupu_csrf
CSRF_HEADER_NAME=x-csrf-token

# ─── Conta do anfitrião ───────────────────────────────────────────────
# Sessão de conta (cookie HttpOnly, Path=/api/v1).
AUTH_COOKIE_NAME=apupu_auth
# Cookie legível com o token CSRF derivado da sessão de conta.
AUTH_CSRF_COOKIE_NAME=apupu_csrf_auth
# 7 dias.
AUTH_SESSION_TTL_MINUTES=10080
# Bloqueio temporário após N falhas de login consecutivas.
AUTH_MAX_FAILED_LOGINS=5
AUTH_LOCK_MINUTES=15
# Validade dos links de verificação de email e de reposição de senha.
EMAIL_VERIFICATION_TTL_MINUTES=1440
PASSWORD_RESET_TTL_MINUTES=60
# Verificação de email por OTP antes da criação da conta.
# Código de 6 dígitos, 10 minutos, 5 tentativas e 60 segundos entre pedidos.
REGISTRATION_OTP_TTL_MINUTES=10
REGISTRATION_OTP_MAX_ATTEMPTS=5
REGISTRATION_OTP_RESEND_SECONDS=60
# Validade do token devolvido por /auth/register/verify-code.
REGISTRATION_VERIFICATION_TTL_MINUTES=15
# Idade mínima aceite para a data de nascimento (opcional no perfil).
MIN_HOST_AGE_YEARS=18

# ─── Retenção de contas ───────────────────────────────────────────────
# Conta sem login durante N meses é eliminada pelo job operacional.
ACCOUNT_RETENTION_MONTHS=24
# Lotes por transacção; mantém locks curtos em bases grandes.
RETENTION_BATCH_SIZE=500

# Parâmetros do Argon2id (senhas). Não baixar em produção.
ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

# Capacidade do navegador que reclamou um convite.
GUEST_COOKIE_NAME=apupu_guest
GUEST_COOKIE_TTL_DAYS=180

# ─── Email ────────────────────────────────────────────────────────────
# json   = não envia emails; escreve mensagens renderizadas em EMAIL_JSON_DIR.
# smtp   = envia por SMTP (credenciais abaixo). Se SMTP_PASS estiver vazio
#          mas RESEND_API_KEY existir, usa o SMTP do Resend
#          (smtp.resend.com, utilizador resend, porta 465/SSL).
# resend = envia pela API HTTP do Resend com RESEND_API_KEY.
EMAIL_TRANSPORT=json
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Chave do Resend. Serve o modo `resend` e o fallback SMTP acima.
# Nunca colocar esta chave no frontend nem no repositório.
RESEND_API_KEY=
EMAIL_FROM=Conto Contigo <convites@apupu.local>

# Brevo SMTP (EMAIL_TRANSPORT=brevo). Use SMTP key, não API key, como senha.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
BREVO_API_KEY=
BREVO_FROM_NAME=Conto Contigo
BREVO_FROM_EMAIL=

# Em desenvolvimento, as mensagens são escritas aqui (nunca nos logs).
EMAIL_JSON_DIR=tmp/outbox

# Outbox: tentativas máximas e base do backoff exponencial.
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_BASE_MS=60000

# ─── Cloudinary — avatares ────────────────────────────────────────────
# Upload assinado no servidor em POST /api/v1/host/profile/avatar/upload.
# O API secret nunca sai do backend. Sem estas três variáveis o upload
# responde 503 avatar_upload_unavailable; o avatar por URL continua
# disponível em POST /api/v1/host/profile/avatar.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_AVATAR_FOLDER=conta-comigo/avatars
# Limite do ficheiro enviado (5 MiB).
AVATAR_MAX_BYTES=5242880

# ─── Lembretes e outbox ───────────────────────────────────────────────
# Cadência aprovada: 14, 7, 3 e 1 dia antes do início do evento.
REMINDER_OFFSETS_DAYS=14,7,3,1
# Hora local do evento a que os lembretes são enviados (0–23).
REMINDER_LOCAL_HOUR=9
# Liga o worker que envia convites, lembretes e avisos.
OUTBOX_ENABLED=true
OUTBOX_SCAN_INTERVAL_MS=60000

# ─── Limites de negócio ───────────────────────────────────────────────
MAX_INVITATIONS_PER_EVENT=1000
