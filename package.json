{
  "name": "conto-contigo-backend",
  "version": "0.1.0",
  "description": "API REST do Conto Contigo — plataforma de convites para eventos",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/assets','dist/assets',{recursive:true})\"",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "seed": "tsx src/scripts/seeds/index.ts",
    "seed:docker": "node dist/scripts/seeds/index.js",
    "smoke": "tsx src/scripts/smokeTest.ts",
    "email:preview": "tsx src/scripts/previewEmails.ts",
    "outbox:run": "tsx src/scripts/runReminders.ts",
    "worker": "tsx src/worker.ts",
    "worker:start": "node dist/worker.js",
    "reminders:run": "tsx src/scripts/runReminders.ts",
    "retention:run": "tsx src/scripts/runRetention.ts",
    "test": "vitest run",
    "test:teams": "bash scripts/test-teams.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "conto-contigo",
    "convites",
    "eventos",
    "api"
  ],
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "node-pg-migrate": "^7.9.1",
    "nodemailer": "^10.5.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.22.0",
    "pino": "^10.4.0",
    "pino-pretty": "^13.2.0",
    "qrcode": "^1.5.4",
    "svg-to-pdfkit": "^0.1.8",
    "swagger-jsdoc": "^6.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.7",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/svg-to-pdfkit": "^0.1.5",
    "@types/swagger-jsdoc": "^6.0.4",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.7.0",
    "prettier": "^3.9.6",
    "supertest": "^7.3.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vitest": "^5.0.5"
  }
}
